# Base URL of the TraceBack FastAPI backend (includes the /api/v1 prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Data mode: "live" talks to the backend; "mock" uses the isolated, clearly-labelled demo fixtures.
# Mock mode is never selected automatically when the live API fails.
VITE_DATA_MODE=live

# Request timeout in milliseconds (Copilot requests use 3x this value)
VITE_REQUEST_TIMEOUT_MS=15000

# Fallback risk-score thresholds used ONLY to draw reference lines on charts.
# The backend does not expose its thresholds; these mirror backend/.env defaults and are labelled "configured" in the UI.
VITE_WATCH_RISK_THRESHOLD=45
VITE_CRITICAL_RISK_THRESHOLD=75
