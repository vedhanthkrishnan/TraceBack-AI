# Exasol Connection
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=TRACEBACK_AI
EXASOL_ENCRYPTION=false
EXASOL_CONNECTION_TIMEOUT=10
EXASOL_QUERY_TIMEOUT=30

# Mock Mode (Fallback when Exasol instance is unavailable)
# Options: false (default, connects to real Exasol), true (isolated memory/sqlite fallback)
MOCK_EXASOL=false

# LLM / AI Copilot Provider
# Options: mock, openai, anthropic, gemini, custom
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Analytics & Risk Thresholds
BASELINE_WINDOW=30
DRIFT_WINDOW=15
WATCH_THRESHOLD=45.0
CRITICAL_THRESHOLD=75.0
DEMO_MODE=false
